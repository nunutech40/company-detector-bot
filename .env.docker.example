# Docker production defaults. Copy to .env and replace all CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME
WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
DASHBOARD_BASE_URL=http://localhost:3001
DASHBOARD_PUBLIC_BASE_URL=http://localhost:3001
# Keep application ports private behind the office reverse proxy.
DASHBOARD_BIND_PORT=127.0.0.1:3001
WEBHOOK_BIND_PORT=127.0.0.1:3002

# Optional Google Business review monitor uses a separate secret file:
# .env.review-monitor, created from .env.review-monitor.example.

REGISTER_WORKER_MODE=agent
REGISTER_WORKER_DELIVER_TELEGRAM=true
OPENCLAW_BIN=/usr/local/bin/openclaw

# OpenClaw / LLM config. Ganti model dari sini, bukan dari kode.
OPENCLAW_CONFIGURE=true
LLM_PROVIDER=9router
LLM_BASE_URL=https://9router.komerce-tech.id/v1
LLM_API=openai-completions
LLM_API_KEY=not-required
LLM_PRIMARY_MODEL=9router/komerce-1.2
LLM_MODEL_ID=komerce-1.2
LLM_ADDITIONAL_MODELS=
LLM_TIMEOUT_SECONDS=120
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# Telegram values are secrets/destinations. Fill only in local .env or server secret manager.
TELEGRAM_ALLOW_FROM=
TELEGRAM_ASSISTANT_ALLOW_FROM=
TELEGRAM_DEFAULT_BOT_TOKEN=
TELEGRAM_ASSISTANT_BOT_TOKEN=
REGISTER_WORKER_TELEGRAM_TO=

# Search enrichment
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Slack daily prospect digest, scheduled at 09:00 WIB by default.
SLACK_BOT_TOKEN=
SLACK_REPORT_CHANNEL=
SLACK_DIGEST_MIN_CONFIDENCE=60
SLACK_DIGEST_HOUR_WIB=9
SLACK_DIGEST_MINUTE_WIB=0

# Worker tuning
REGISTER_WORKER_AGENT_TIMEOUT_SEC=900
REGISTER_WORKER_MAX_ATTEMPTS=3
REGISTER_WORKER_IDLE_MS=10000
REGISTER_WORKER_RUN_TIMEOUT_MS=120000
