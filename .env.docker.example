# Local Docker smoke-test defaults. Copy to .env and replace values for production.
POSTGRES_PASSWORD=CHANGE_ME
WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
DASHBOARD_BASE_URL=http://localhost:3001
DASHBOARD_BIND_PORT=3001
WEBHOOK_BIND_PORT=3002

# Local smoke test defaults to deterministic because the OpenClaw runtime is
# not needed for webhook/dashboard/DB validation.
REGISTER_WORKER_MODE=deterministic
REGISTER_WORKER_DELIVER_TELEGRAM=false
OPENCLAW_BIN=/usr/local/bin/openclaw

# OpenClaw / LLM config. Ganti model dari sini, bukan dari kode.
# For production agent mode:
#   OPENCLAW_CONFIGURE=true
#   REGISTER_WORKER_MODE=agent
#   REGISTER_WORKER_DELIVER_TELEGRAM=true
OPENCLAW_CONFIGURE=false
LLM_PROVIDER=sumopod
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_PRIMARY_MODEL=sumopod/kimi-k2.6
LLM_MODEL_ID=kimi-k2.6
LLM_ADDITIONAL_MODELS=komerce,qwen3.6-flash
LLM_TIMEOUT_SECONDS=120

# Telegram values are secrets/destinations. Fill only in local .env or server secret manager.
TELEGRAM_ALLOW_FROM=
TELEGRAM_ASSISTANT_ALLOW_FROM=
TELEGRAM_DEFAULT_BOT_TOKEN=
TELEGRAM_ASSISTANT_BOT_TOKEN=

# Worker tuning
REGISTER_WORKER_AGENT_TIMEOUT_SEC=900
REGISTER_WORKER_MAX_ATTEMPTS=3
REGISTER_WORKER_IDLE_MS=10000
REGISTER_WORKER_RUN_TIMEOUT_MS=120000
