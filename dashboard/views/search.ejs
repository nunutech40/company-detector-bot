<div class="page-title">Hasil pencarian: "<%= q %>"</div>

<% if (jobs.length === 0) { %>
<div class="empty"><div class="icon">🔍</div><div>Tidak ada hasil untuk "<%= q %>"</div></div>
<% } else { %>

<div class="table-wrap">
<table>
  <thead>
    <tr>
      <th>Waktu</th>
      <th>Email</th>
      <th>Bisnis / Person</th>
      <th>Classification</th>
      <th>Confidence</th>
      <th>Marketplace</th>
      <th>Sosmed</th>
    </tr>
  </thead>
  <tbody>
  <% for (const job of jobs) { %>
  <%
    const ci = classInfo(job.classification);
    const confClass = job.confidence_score >= 75 ? 'conf-high' : job.confidence_score >= 45 ? 'conf-medium' : 'conf-low';
    const mkt = Array.isArray(job.marketplace_json) ? job.marketplace_json : [];
    const soc = Array.isArray(job.social_media_json) ? job.social_media_json : [];
    const dt  = job.finished_at ? new Date(job.finished_at).toLocaleString('id-ID', {timeZone:'Asia/Jakarta',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '—';
  %>
  <tr>
    <td style="color:#64748b;font-size:12px;white-space:nowrap"><%= dt %></td>
    <td><a href="/jobs/<%= job.id %>"><%= job.email %></a></td>
    <td>
      <% if (job.business_name) { %><div style="font-weight:600;color:#fff"><%= job.business_name %></div><% } %>
      <% if (job.person_name) { %><div style="color:#94a3b8;font-size:12px"><%= job.person_name %></div><% } %>
      <% if (job.business_city) { %><div style="color:#64748b;font-size:11px">📍 <%= job.business_city %></div><% } %>
    </td>
    <td><span class="badge badge-<%= ci.color %>"><%= ci.label %></span></td>
    <td>
      <div class="conf-bar">
        <div class="conf-bar-bg"><div class="conf-bar-fill <%= confClass %>" style="width:<%= job.confidence_score || 0 %>%"></div></div>
        <span style="font-size:12px;color:#94a3b8"><%= job.confidence_score || 0 %></span>
      </div>
    </td>
    <td>
      <div class="platforms">
        <% for (const m of mkt) { %><span class="platform-tag"><%= m.platform %></span><% } %>
        <% if (!mkt.length) { %><span style="color:#2d3148">—</span><% } %>
      </div>
    </td>
    <td>
      <div class="platforms">
        <% for (const s of soc.slice(0,4)) { %><span class="platform-tag"><%= s.platform %></span><% } %>
        <% if (soc.length > 4) { %><span class="platform-tag">+<%= soc.length - 4 %></span><% } %>
        <% if (!soc.length) { %><span style="color:#2d3148">—</span><% } %>
      </div>
    </td>
  </tr>
  <% } %>
  </tbody>
</table>
</div>
<div style="color:#64748b;font-size:12px;margin-top:12px"><%= jobs.length %> hasil ditemukan</div>
<% } %>
