# Company Detector runtime environment example.
# Copy to ~/.openclaw/gateway.systemd.env on the server and fill real values.
# Never commit real secrets.

# PostgreSQL
DATABASE_URL=postgresql://company_detection:CHANGE_ME@127.0.0.1:5432/company_detection

# Webhook auth
WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Public URLs
DASHBOARD_BASE_URL=http://127.0.0.1:3001
DASHBOARD_PUBLIC_BASE_URL=https://company-detector.example.com
SALES_SHEET_WEB_URL=https://company-detector.example.com/sales-sheet
SALES_SHEET_LATEST_URL=https://company-detector.example.com/sales-sheet/latest.xlsx
SALES_SHEET_EXPORT_DIR=/home/companydetector/.openclaw/dashboard/public/exports

# Ports
DASHBOARD_PORT=3001
WEBHOOK_PORT=3002

# OpenClaw / LLM provider
OPENCLAW_BASE_URL=https://9router.komerce-tech.id/v1
OPENCLAW_PRIMARY_MODEL=9router/komerce-1.2

# Search providers
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_REPORT_CHANNEL=
BRANDS_PROSPECT_ALERT_SLACK_CHANNEL=
NEGATIVE_MONITOR_ALERT_SLACK_CHANNEL=monitor-negatif-company
SLACK_DIGEST_MIN_CONFIDENCE=60

# Telegram delivery
TELEGRAM_DELIVERY_TO=
REGISTER_WORKER_TELEGRAM_TO=

# Worker behavior
OPENCLAW_WORKSPACE=/home/companydetector/.openclaw/workspace
OPENCLAW_BIN=/home/companydetector/.npm-global/bin/openclaw
REGISTER_WORKER_MODE=agent
REGISTER_WORKER_AGENT_TIMEOUT_SEC=900
REGISTER_WORKER_DELIVER_TELEGRAM=true
REGISTER_WORKER_MAX_ATTEMPTS=3
REGISTER_WORKER_RECOVERY_REPLAY_LIMIT=5
REGISTER_WORKER_CIRCUIT_FAILURE_THRESHOLD=2
REGISTER_WORKER_CIRCUIT_CANARY_INTERVAL_MS=900000
REGISTER_WORKER_CIRCUIT_CANARY_TIMEOUT_MS=30000
REGISTER_WORKER_MAX_BACKOFF_SEC=1800
REGISTER_WORKER_IDLE_MS=10000
REGISTER_WORKER_RUN_TIMEOUT_MS=120000

# Operational health monitor. Reads systemd/PostgreSQL only; never calls AI.
OPS_HEALTH_QUEUE_STALL_MINUTES=25
OPS_HEALTH_AI_WINDOW_MINUTES=10
OPS_HEALTH_SERVICE_CONFIRM_CHECKS=2
OPS_HEALTH_RECOVERY_CONFIRM_CHECKS=2
