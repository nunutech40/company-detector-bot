[Unit]
Description=Company Detector dashboard
After=network-online.target postgresql.service

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/dashboard
EnvironmentFile=%h/.openclaw/gateway.systemd.env
Environment=DASHBOARD_PORT=3001
ExecStart=/usr/bin/env node app.js
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
