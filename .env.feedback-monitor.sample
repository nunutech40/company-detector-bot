# Copy values into .env.feedback-monitor on the deployment server.
# This sample is intentionally safe to commit; do not put real secrets here.

# Runtime
FEEDBACK_MONITOR_PORT=3003
FEEDBACK_WORKER_IDLE_MS=5000
FEEDBACK_WORKER_MAX_ATTEMPTS=3
FEEDBACK_DELIVERY_DRY_RUN=true

# Active source: Meta Graph API polling.
# Production VPS runs the next poll 15 minutes after the previous poll finishes.
# Webhook is not the active source until the Meta App callback is configured and subscribed.
META_GRAPH_VERSION=v20.0
META_ACCESS_TOKEN=
META_PAGE_IDS=
META_POST_LIMIT=100
META_COMMENT_LIMIT=50
META_LOOKBACK_MINUTES=1440
META_PAGE_CONCURRENCY=2
META_COMMENT_CONCURRENCY=5

# Optional/future source: Meta Webhook verification.
# Endpoint exists at /webhook/meta, but it is idle until Meta App webhook subscription is enabled.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Future/optional Google Pub/Sub push security placeholder.
# Google Business Profile API access is still pending approval.
# Google review monitoring will use rating 1-3 deterministic routing and will not call AI.
GOOGLE_PUBSUB_PUSH_TOKEN=

# AI classifier for Meta comments.
# Use "stub" for local/simulator tests without external AI.
# Production uses an OpenAI-compatible provider/model configured here.
FEEDBACK_AI_PROVIDER=9router
FEEDBACK_AI_BASE_URL=https://9router.komerce-tech.id/v1
FEEDBACK_AI_API_KEY=not-required
FEEDBACK_AI_MODEL=komerce-1.2
FEEDBACK_AI_TEMPERATURE=0.2
FEEDBACK_AI_TIMEOUT_MS=120000
FEEDBACK_CLASSIFIER_VERSION=meta-ai:9router:komerce-1.2:v1
FEEDBACK_AI_CONFIG_FINGERPRINT=9router-komerce-1.2-v1

# Delivery
FEEDBACK_TELEGRAM_TO=
TELEGRAM_DEFAULT_BOT_TOKEN=
SLACK_BOT_TOKEN=
REVIEW_MONITOR_SLACK_CHANNEL=monitor-negatif-company
