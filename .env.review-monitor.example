# Google Business Profile Review Monitor.
# Copy to .env.review-monitor, chmod 600, then fill real values.

# Development target: use a Business Profile owned/managed by your personal
# Google account. Replace with office credentials/location for production.
GBP_BUSINESS_NAME=CHANGE_ME_WARUNG_NAME
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# OAuth client created in Google Cloud Console.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# Google OAuth/API endpoints. Usually no need to change.
GBP_TOKEN_URL=https://oauth2.googleapis.com/token
GBP_API_BASE_URL=https://mybusiness.googleapis.com/v4

# Monitor behavior.
REVIEW_MONITOR_PROVIDER=google-business-profile-api
REVIEW_MONITOR_COLLECT_HOUR_WIB=21
REVIEW_MONITOR_SEND_HOUR_WIB=9
REVIEW_MONITOR_MINUTE_WIB=0

# Telegram delivery for this isolated feature.
TELEGRAM_DEFAULT_BOT_TOKEN=
REVIEW_MONITOR_TELEGRAM_TO=
